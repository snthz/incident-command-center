# Supabase (local dev: values printed by `supabase start` / `supabase status`)
# Read at RUNTIME on the server; the browser receives them via window.__ENV.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Direct Postgres connection used by Prisma and the startup migrator (server-side only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
