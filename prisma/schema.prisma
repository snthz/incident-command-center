generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IncidentSeverity {
  critical
  high
  medium
  low

  @@map("incident_severity")
}

enum IncidentStatus {
  investigating
  identified
  monitoring
  resolved

  @@map("incident_status")
}

model Profile {
  id        String   @id @db.Uuid
  name      String
  email     String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ownedIncidents        Incident[]
  updates               IncidentUpdate[]
  notificationsReceived Notification[]   @relation("NotificationRecipient")
  notificationsSent     Notification[]   @relation("NotificationActor")

  @@map("profiles")
}

model Incident {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique @default(dbgenerated("('ICC-'::text || nextval('incident_key_seq'::regclass))"))
  title       String
  description String
  severity    IncidentSeverity
  status      IncidentStatus   @default(investigating)
  ownerId     String?          @map("owner_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  resolvedAt  DateTime?        @map("resolved_at") @db.Timestamptz(6)
  position    Float            @default(0)

  owner         Profile?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  updates       IncidentUpdate[]
  notifications Notification[]

  @@index([status])
  @@index([severity])
  @@index([status, position])
  @@map("incidents")
}

model IncidentUpdate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  message    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   Profile? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_updates")
}

model Notification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId   String    @map("recipient_id") @db.Uuid
  actorId       String?   @map("actor_id") @db.Uuid
  incidentId    String?   @map("incident_id") @db.Uuid
  incidentKey   String    @map("incident_key")
  incidentTitle String    @map("incident_title")
  type          String
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient Profile   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     Profile?  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  incident  Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}
