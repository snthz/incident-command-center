generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IncidentSeverity {
  critical
  high
  medium
  low

  @@map("incident_severity")
}

enum IncidentStatus {
  investigating
  identified
  monitoring
  resolved

  @@map("incident_status")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  members  OrganizationMember[]
  projects Project[]

  @@map("organizations")
}

model OrganizationMember {
  organizationId String   @map("organization_id") @db.Uuid
  profileId      String   @map("profile_id") @db.Uuid
  role           String   @default("member")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([organizationId, profileId])
  @@map("organization_members")
}

model Project {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  slug           String
  keyPrefix      String   @map("key_prefix")
  color          String   @default("#898989")
  nextNumber     Int      @default(0) @map("next_number")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incidents    Incident[]

  @@unique([organizationId, slug])
  @@unique([organizationId, keyPrefix])
  @@map("projects")
}

model Profile {
  id        String   @id @db.Uuid
  name      String
  email     String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ownedIncidents        Incident[]
  updates               IncidentUpdate[]
  notificationsReceived Notification[]       @relation("NotificationRecipient")
  notificationsSent     Notification[]       @relation("NotificationActor")
  memberships           OrganizationMember[]
  watching              IncidentWatcher[]
  incidentEvents        IncidentEvent[]

  @@map("profiles")
}

model IncidentEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  type       String
  fromValue  String?  @map("from_value")
  toValue    String?  @map("to_value")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt(sort: Desc)])
  @@map("incident_events")
}

model IncidentWatcher {
  incidentId String   @map("incident_id") @db.Uuid
  profileId  String   @map("profile_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([incidentId, profileId])
  @@index([profileId])
  @@map("incident_watchers")
}

model Incident {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique @default(dbgenerated())
  number      Int              @default(dbgenerated())
  projectId   String           @map("project_id") @db.Uuid
  title       String
  description String
  severity    IncidentSeverity
  status      IncidentStatus   @default(investigating)
  ownerId     String?          @map("owner_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  resolvedAt  DateTime?        @map("resolved_at") @db.Timestamptz(6)
  dueDate     DateTime?        @map("due_date") @db.Timestamptz(6)
  position    Float            @default(0)

  owner         Profile?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updates       IncidentUpdate[]
  notifications Notification[]
  watchers      IncidentWatcher[]
  events        IncidentEvent[]

  @@unique([projectId, number])

  @@index([status])
  @@index([severity])
  @@index([status, position])
  @@map("incidents")
}

model IncidentUpdate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  message    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   Profile? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_updates")
}

model Notification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId   String    @map("recipient_id") @db.Uuid
  actorId       String?   @map("actor_id") @db.Uuid
  incidentId    String?   @map("incident_id") @db.Uuid
  incidentKey   String    @map("incident_key")
  incidentTitle String    @map("incident_title")
  type          String
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient Profile   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     Profile?  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  incident  Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}
